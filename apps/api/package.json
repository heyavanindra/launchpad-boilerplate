{
  "name": "nodejs-boilerplate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "dotenvx run -f .env.development -- tsx watch src/index.ts",
    "dev:worker": "dotenvx run -f .env.development -- tsx watch src/worker.ts",
    "start": "dotenvx run -f .env -- node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "db:push": "dotenvx run -f .env.development -- drizzle-kit push",
    "db:studio": "dotenvx run -f .env.development -- drizzle-kit studio",
    "db:generate": "dotenvx run -f .env.development -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env.development -- drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/eslint-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@dotenvx/dotenvx": "^2.22.0",
    "@types/express": "^5.0.6",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.4",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  }
}
